{
  "private": true,
  "scripts": {
    "build": "cross-env APP_ENV=production next build",
    "build:maintenance": "cross-env APP_ENV=maintenance dotenv -e .env.maintenance next build",
    "build:staging": "cross-env APP_ENV=staging dotenv -e .env.staging next build",
    "dev": "next dev",
    "start": "cross-env APP_ENV=production next start",
    "start:maintenance": "cross-env APP_ENV=maintenance dotenv -e .env.maintenance next start",
    "start:staging": "cross-env APP_ENV=staging dotenv -e .env.staging next start"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0"
  }
}
